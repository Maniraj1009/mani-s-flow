{
   "action": {
      "default_icon": {
         "128": "icons/icon-128.png",
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png"
      },
      "default_title": "Mani's Flow"
   },
   "background": {
      "service_worker": "background/service-worker.js"
   },
   "content_scripts": [ {
      "js": [ "selectors.js", "content.js" ],
      "matches": [ "https://labs.google/fx/*" ],
      "run_at": "document_idle"
   } ],
   "description": "Queue prompts for bulk image generation on Google Flow (labs.google/fx/tools/flow). Mani's Flow.",
   "host_permissions": [
      "https://labs.google/fx/*",
      "https://*.googleusercontent.com/*",
      "https://*.googleapis.com/*"
   ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "114",
   "name": "Mani's Flow",
   "permissions": [ "storage", "sidePanel", "unlimitedStorage", "scripting", "downloads" ],
   "side_panel": {
      "default_path": "sidepanel/sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.2.3"
}
